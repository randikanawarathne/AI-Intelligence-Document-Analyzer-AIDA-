# AIDA — Local Intelligence Environment Configuration
# Configured for Local Ollama LLM (Zero Cloud API Keys Required)

LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional Cloud API Keys (Leave empty for 100% local operation)
OPENAI_API_KEY=
GEMINI_API_KEY=

# RAG Hyperparameters
CHUNK_SIZE=450
CHUNK_OVERLAP=50
TOP_K=5
